# Banco (Turso / libSQL) — banco PRÓPRIO do cgc-atividades, não o do checklist.
TURSO_DATABASE_URL=libsql://exemplo.turso.io
TURSO_AUTH_TOKEN=

# Validação do sasi-token da URL — mesmo AUTH_USER_ENDPOINT do cgc-checklist,
# os dois validam contra o mesmo serviço externo de login.
AUTH_USER_ENDPOINT=

# --- API SASI (Bone) ---

# Token da API SASI usado em desenvolvimento, quando não há sasi-token na URL.
# Criado em POST /provider/api-tokens com escopo READ_MESSAGES.
SASI_API_TOKEN=

# Opcionais — os defaults já apontam para a API de produção.
# SASI_API_BASE_URL=https://api.bone.sasi.io
# SASI_API_TIMEOUT_MS=15000
# SASI_CGC_SCAN_CAP=500
# SASI_CGC_FIELD_GROUP=selecione_time
# SASI_CGC_FIELD_PRIORITY=prioridades
# SASI_CGC_FIELD_DEADLINE=prazo_de_entrega
# SASI_CGC_FIELD_DESCRIPTION=descreva

# Data de corte da listagem (YYYY-MM-DD, fuso America/Campo_Grande) — mensagem
# anterior a ela não aparece em nenhum grupo, mesmo pendente. Sem essa env var,
# o corte é sempre hoje. Redefinir aqui manualmente quando quiser abrir a janela
# (ex.: atividade NAO_INICIADO antiga que não pode sumir da lista).
# CGC_DISPLAY_CUTOFF_DATE=2026-08-31

# Segredo compartilhado com o cgc-checklist (mesmo valor nos dois
# .env.local) que autentica as chamadas do proxy de /api/controle/cgc* dessas
# duas rotas, conferido contra o header x-controle-secret. Sem essa env var
# (ou com o header errado), as rotas recusam com 401 — elas viraram
# alcançáveis pela rede depois da separação em dois apps, então não podem
# mais depender de serem "mesmo processo" pra estar protegidas.
CONTROLE_PROXY_SECRET=

# GET /api/controle/cgc/idr (header x-idr-secret). Secret dedicado, separado
# de CONTROLE_PROXY_SECRET, usado pelo cgc-idr pra ler os dados do canal 36602.
CGC_IDR_PROXY_SECRET=

# Segredo que autoriza o cron externo (GitHub Actions) a chamar
# GET /api/cgc/cron-sync (header x-cron-secret). Sem essa env var, a rota
# recusa qualquer chamada — não há AUTH_USER_ENDPOINT pra validar quem chama
# um cron, então o segredo é a única defesa.
CGC_CRON_SECRET=

# Segredo do webhook do SASI (POST/GET /api/cgc/webhook), cadastrado
# manualmente no painel admin.sasi.io pro canal 33397. Separado do
# CGC_CRON_SECRET porque a URL fica num painel de terceiro fora do nosso
# controle — assim dá pra trocar essa credencial sem mexer no GitHub Actions.
# Aceita tanto no header x-webhook-secret quanto na query string ?secret=,
# porque não dá pra saber de antemão se o painel do SASI permite header
# customizado.
CGC_WEBHOOK_SECRET=

# --- Push de notificação (SASI notify) ---
# Host e credencial diferentes da Bone API: fala com api.sasi.io
# (POST /api/v2/providers/subscriptions/{key}/notify), não api.bone.sasi.io.
# Sem SASI_NOTIFY_TOKEN configurado, notifySubscription() é um no-op
# silencioso — a notificação fica desligada até a credencial existir, sem
# precisar de feature flag separada.
# SASI_NOTIFY_API_BASE_URL=https://api.sasi.io
SASI_NOTIFY_TOKEN=
# Chave de subscription notificada — mesma pros quatro grupos seedados por ora.
# SASI_NOTIFY_SUBSCRIPTION_KEY=app:1619
